import assert from 'node:assert/strict';
import { describe, it } from 'node:test';
import { spawn } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import { join, dirname } from 'node:path';

const ROOT = dirname(dirname(fileURLToPath(import.meta.url)));

function runCli(args = []) {
  return new Promise((resolve, reject) => {
    const proc = spawn(process.execPath, [join(ROOT, 'bin', '{{name}}.mjs'), ...args]);
    let out = '', err = '';
    proc.stdout.on('data', d => { out += d; });
    proc.stderr.on('data', d => { err += d; });
    proc.on('close', code => {
      if (code === 0) resolve({ stdout: out, stderr: err });
      else {
        const e = Object.assign(new Error(err || `exit ${code}`), { code, stdout: out, stderr: err });
        reject(e);
      }
    });
  });
}

describe('{{name}} CLI', () => {
  it('prints version', async () => {
    const { stdout } = await runCli(['--version']);
    assert.match(stdout.trim(), /^\d+\.\d+\.\d+$/);
  });

  it('shows help', async () => {
    const { stdout } = await runCli(['--help']);
    assert.match(stdout, /Usage: {{name}}/);
  });

  it('rejects unknown command', async () => {
    await assert.rejects(runCli(['_nope_']), err => {
      assert.equal(err.code, 1);
      assert.match(err.stderr, /Unknown command/);
      return true;
    });
  });
});
